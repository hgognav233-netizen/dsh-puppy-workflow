{
  "name": "puppy-workflow",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "A beginner view of the running Harness session: a real-time 3D island garden drawn as pixel art (three.js, Blender model) where dogs act out every real tool call and a whale stands for the model.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "stage3d.js",
    "pixel-look.js",
    "assets/island.glb",
    "vendor/**",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
